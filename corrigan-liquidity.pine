//@version=6
// Corrigan liquidity strategy. Fail the level, then enter the reclaim. Not the first touch.
// Long: traded above the level, failed through it, candle closed back above.
// Short: traded below the level, swept above it, candle closed back below.
// Stop is the sweep. Target is 1R. Flat at the session cutoff.
// The fill is the next bar's open. The stop and target can fill inside the bar.
// A Jun 30–Sep 30 2026 replay of this mechanical version lost on QQQ, SPY, and NVDA.
// Use a 5-minute chart. Alert: "Any alert() function call", once per bar close.
// If the strategy arrows sit on the labels, open the script's Style tab and uncheck Trades.
strategy("Corrigan Liquidity", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, process_orders_on_close=false, calc_on_every_tick=false, use_bar_magnifier=true, margin_long=100, margin_short=100, max_labels_count=500)

tz = "America/New_York"

grpT = "Trend"
emaLen  = input.int(21, "EMA length", minval=2, group=grpT)
emaTf   = input.timeframe("D", "EMA timeframe", group=grpT, tooltip="He uses the 21 EMA on the daily, the hourly, or the 15-minute. Daily is the default.")
needEma = input.bool(true, "Require trend agreement", group=grpT)
needVwap = input.bool(true, "Require VWAP side", group=grpT, tooltip="Longs only above the session VWAP. Shorts only below it.")

grpL = "Levels"
usePdh = input.bool(true, "Prior day high", group=grpL)
usePdl = input.bool(true, "Prior day low", group=grpL)
useOr  = input.bool(true, "15-minute opening range", group=grpL)
useWk  = input.bool(false, "Prior week high and low", group=grpL)

grpR = "Risk"
tpR    = input.float(1.0, "Target (R)", minval=0.2, step=0.1, group=grpR)
useAtr = input.bool(true, "Skip absurd stops", group=grpR, tooltip="Drop a sweep tighter than 0.15 ATR or wider than 1.5 ATR.")
atrLen = input.int(10, "ATR length", minval=2, group=grpR)

grpS = "Session (ET)"
sessOn = input.bool(true, "Session filter", group=grpS)
startT = input.int(945, "Earliest entry", group=grpS)
lastT  = input.int(1500, "Last entry", group=grpS)
flatT  = input.int(1545, "Flatten", group=grpS)

emaHTF = request.security(syminfo.tickerid, emaTf, ta.ema(close, emaLen), barmerge.gaps_off, barmerge.lookahead_off)
pdh = request.security(syminfo.tickerid, "D", high, barmerge.gaps_off, barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low, barmerge.gaps_off, barmerge.lookahead_off)
wkh = request.security(syminfo.tickerid, "W", high, barmerge.gaps_off, barmerge.lookahead_off)
wkl = request.security(syminfo.tickerid, "W", low, barmerge.gaps_off, barmerge.lookahead_off)
vwap = ta.vwap(hlc3)
atr = ta.atr(atrLen)

h = hour(time, tz)
m = minute(time, tz)
tNum = h * 100 + m
dayKey = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
newDay = ta.change(dayKey) != 0
inEntry = not sessOn or (tNum >= startT and tNum < lastT and tNum < flatT)
trendUp = not needEma or na(emaHTF) or close > emaHTF
trendDn = not needEma or na(emaHTF) or close < emaHTF
aboveVwap = not needVwap or close > vwap
belowVwap = not needVwap or close < vwap

type Sweep
    bool seen
    bool hot
    float extreme
    bool used

f_reset(Sweep s) =>
    s.seen := false
    s.hot := false
    s.extreme := na
    s.used := false

// Fail back through, then close reclaimed. The first touch does not arm a trade.
f_reclaim(float level, Sweep s, bool wantLong) =>
    bool ready = false
    float extreme = na
    if not na(level)
        if wantLong
            if s.seen and low < level
                s.hot := true
                s.extreme := na(s.extreme) ? low : math.min(s.extreme, low)
            if s.hot and close > level and not na(s.extreme)
                ready := not s.used
                extreme := s.extreme
                s.hot := false
                s.extreme := na
            if high > level
                s.seen := true
        else
            if s.seen and high > level
                s.hot := true
                s.extreme := na(s.extreme) ? high : math.max(s.extreme, high)
            if s.hot and close < level and not na(s.extreme)
                ready := not s.used
                extreme := s.extreme
                s.hot := false
                s.extreme := na
            if low < level
                s.seen := true
    [ready, extreme]

var Sweep pdhLong = Sweep.new(false, false, na, false)
var Sweep pdlLong = Sweep.new(false, false, na, false)
var Sweep orLong  = Sweep.new(false, false, na, false)
var Sweep wkLong  = Sweep.new(false, false, na, false)
var Sweep pdhShort = Sweep.new(false, false, na, false)
var Sweep pdlShort = Sweep.new(false, false, na, false)
var Sweep orShort  = Sweep.new(false, false, na, false)
var Sweep wkShort  = Sweep.new(false, false, na, false)

var float orH = na
var float orL = na
var bool orLocked = false
var float sl = na
var float tp = na
var string why = ""

if newDay
    f_reset(pdhLong)
    f_reset(pdlLong)
    f_reset(orLong)
    f_reset(wkLong)
    f_reset(pdhShort)
    f_reset(pdlShort)
    f_reset(orShort)
    f_reset(wkShort)
    orH := na
    orL := na
    orLocked := false

if tNum >= 930 and tNum < 945
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
else if tNum >= 945 and not orLocked and not na(orL)
    orLong.seen := true
    orShort.seen := true
    orLocked := true

[pdhL, pdhLsl] = f_reclaim(usePdh ? pdh : na, pdhLong, true)
[pdlL, pdlLsl] = f_reclaim(usePdl ? pdl : na, pdlLong, true)
[orLsig, orLsl] = f_reclaim(useOr and orLocked ? orL : na, orLong, true)
[wkLsig, wkLsl] = f_reclaim(useWk ? wkl : na, wkLong, true)
[pdhS, pdhSsl] = f_reclaim(usePdh ? pdh : na, pdhShort, false)
[pdlS, pdlSsl] = f_reclaim(usePdl ? pdl : na, pdlShort, false)
[orSsig, orSsl] = f_reclaim(useOr and orLocked ? orH : na, orShort, false)
[wkSsig, wkSsl] = f_reclaim(useWk ? wkh : na, wkShort, false)

f_ok(float extreme, bool isLong) =>
    float risk = isLong ? close - extreme : extreme - close
    bool wide = not useAtr or (not na(atr) and risk >= atr * 0.15 and risk <= atr * 1.5)
    risk > syminfo.mintick * 2 and wide

f_note(string side, float px, string name) =>
    side + " " + str.tostring(px, format.mintick) + "  " + name

bool flat = strategy.position_size == 0
bool canEnter = barstate.isconfirmed and flat and inEntry

if canEnter and trendUp and aboveVwap and pdhL and f_ok(pdhLsl, true)
    sl := pdhLsl
    tp := close + (close - pdhLsl) * tpR
    why := "PDH"
    pdhLong.used := true
    strategy.entry("L", strategy.long, comment="")
    strategy.exit("LX", from_entry="L", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendUp and aboveVwap and pdlL and f_ok(pdlLsl, true)
    sl := pdlLsl
    tp := close + (close - pdlLsl) * tpR
    why := "PDL"
    pdlLong.used := true
    strategy.entry("L", strategy.long, comment="")
    strategy.exit("LX", from_entry="L", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendUp and aboveVwap and orLsig and f_ok(orLsl, true)
    sl := orLsl
    tp := close + (close - orLsl) * tpR
    why := "OR"
    orLong.used := true
    strategy.entry("L", strategy.long, comment="")
    strategy.exit("LX", from_entry="L", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendUp and aboveVwap and wkLsig and f_ok(wkLsl, true)
    sl := wkLsl
    tp := close + (close - wkLsl) * tpR
    why := "WK"
    wkLong.used := true
    strategy.entry("L", strategy.long, comment="")
    strategy.exit("LX", from_entry="L", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendDn and belowVwap and pdhS and f_ok(pdhSsl, false)
    sl := pdhSsl
    tp := close - (pdhSsl - close) * tpR
    why := "PDH"
    pdhShort.used := true
    strategy.entry("S", strategy.short, comment="")
    strategy.exit("SX", from_entry="S", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendDn and belowVwap and pdlS and f_ok(pdlSsl, false)
    sl := pdlSsl
    tp := close - (pdlSsl - close) * tpR
    why := "PDL"
    pdlShort.used := true
    strategy.entry("S", strategy.short, comment="")
    strategy.exit("SX", from_entry="S", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendDn and belowVwap and orSsig and f_ok(orSsl, false)
    sl := orSsl
    tp := close - (orSsl - close) * tpR
    why := "OR"
    orShort.used := true
    strategy.entry("S", strategy.short, comment="")
    strategy.exit("SX", from_entry="S", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if canEnter and trendDn and belowVwap and wkSsig and f_ok(wkSsl, false)
    sl := wkSsl
    tp := close - (wkSsl - close) * tpR
    why := "WK"
    wkShort.used := true
    strategy.entry("S", strategy.short, comment="")
    strategy.exit("SX", from_entry="S", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")

// Keep the bracket working, or get flat. One exit path so the labels cannot double.
if strategy.position_size > 0 and tNum >= flatT
    strategy.cancel("LX")
    strategy.close("L", comment="FLAT")
else if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")
else if strategy.position_size < 0 and tNum >= flatT
    strategy.cancel("SX")
    strategy.close("S", comment="FLAT")
else if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=sl, limit=tp, comment_profit="TP", comment_loss="SL")

int closedDelta = strategy.closedtrades - nz(strategy.closedtrades[1], 0)
float prevPos = nz(strategy.position_size[1])
bool roundTrip = closedDelta > 0 and prevPos == 0 and strategy.position_size == 0
bool justIn = strategy.position_size != 0 and prevPos == 0
bool justOut = closedDelta > 0 and prevPos != 0

f_tag(int trade) =>
    string cmt = strategy.closedtrades.exit_comment(trade)
    float xp = strategy.closedtrades.exit_price(trade)
    string word = cmt == "TP" ? "TP" : cmt == "FLAT" ? "FLAT" : "SL"
    word + " " + str.tostring(xp, format.mintick)

if roundTrip
    int last = strategy.closedtrades - 1
    float en = strategy.closedtrades.entry_price(last)
    bool wasLong = strategy.closedtrades.size(last) > 0
    label.new(bar_index, wasLong ? low : high, f_note(wasLong ? "BUY" : "SELL", en, why), yloc=wasLong ? yloc.belowbar : yloc.abovebar, style=wasLong ? label.style_label_up : label.style_label_down, color=wasLong ? color.lime : color.red, textcolor=color.black, size=size.tiny, tooltip=why)
    label.new(bar_index, wasLong ? high : low, f_tag(last), yloc=wasLong ? yloc.abovebar : yloc.belowbar, style=wasLong ? label.style_label_down : label.style_label_up, color=strategy.closedtrades.profit(last) > 0 ? color.lime : color.red, textcolor=color.white, size=size.tiny)
    alert((wasLong ? "BUY " : "SELL ") + syminfo.ticker + " @ " + str.tostring(en, format.mintick) + " | " + f_tag(last) + " | " + why, alert.freq_once_per_bar_close)
else if justIn
    bool lng = strategy.position_size > 0
    float px = strategy.position_avg_price
    label.new(bar_index, lng ? low : high, f_note(lng ? "BUY" : "SELL", px, why), yloc=lng ? yloc.belowbar : yloc.abovebar, style=lng ? label.style_label_up : label.style_label_down, color=lng ? color.lime : color.red, textcolor=color.black, size=size.tiny, tooltip="SL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick))
    alert((lng ? "BUY " : "SELL ") + syminfo.ticker + " @ " + str.tostring(px, format.mintick) + " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | " + why, alert.freq_once_per_bar_close)
else if justOut
    int last = strategy.closedtrades - 1
    bool wasLong = strategy.closedtrades.size(last) > 0
    string exitTxt = f_tag(last)
    bool win = strategy.closedtrades.profit(last) > 0
    // Exit sits on the opposite side of the candle from the entry label.
    label.new(bar_index, wasLong ? high : low, exitTxt, yloc=wasLong ? yloc.abovebar : yloc.belowbar, style=wasLong ? label.style_label_down : label.style_label_up, color=win ? color.lime : color.red, textcolor=win ? color.black : color.white, size=size.tiny, tooltip=why)
    alert(exitTxt + " " + syminfo.ticker + " | " + why, alert.freq_once_per_bar_close)

plot(pdh, "PDH", color.new(color.red, 40), 1, plot.style_linebr)
plot(pdl, "PDL", color.new(color.teal, 40), 1, plot.style_linebr)
plot(orLocked ? orH : na, "OR high", color.new(color.orange, 20), 1, plot.style_linebr)
plot(orLocked ? orL : na, "OR low", color.new(color.orange, 20), 1, plot.style_linebr)
plot(emaHTF, "Trend EMA", color.new(color.white, 0), 2)
plot(vwap, "VWAP", color.new(color.aqua, 0), 1)
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, "Entry", color.new(color.orange, 0), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? sl : na, "Stop", color.new(color.red, 0), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? tp : na, "Target", color.new(color.lime, 0), 1, plot.style_linebr)

var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 30))
if barstate.islast
    float gp = strategy.grossprofit
    float gl = strategy.grossloss
    float pf = gl > 0 ? gp / gl : gp > 0 ? 99.0 : 0.0
    table.cell(dash, 0, 0, "Trend", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 0, trendUp and not trendDn ? "UP" : trendDn and not trendUp ? "DOWN" : "FLAT", text_color=trendUp and not trendDn ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 1, "VWAP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, close > vwap ? "ABOVE" : "BELOW", text_color=close > vwap ? color.lime : color.red, text_size=size.tiny)
    table.cell(dash, 0, 2, "Open", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, strategy.position_size == 0 ? "FLAT" : why, text_color=strategy.position_size == 0 ? color.gray : color.orange, text_size=size.tiny)
    table.cell(dash, 0, 3, "Stop / TP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, strategy.position_size == 0 ? "—" : str.tostring(sl, format.mintick) + " / " + str.tostring(tp, format.mintick), text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 0, 4, "Trades", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(strategy.closedtrades) + "  PF " + str.tostring(pf, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 5, "Net", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, "$" + str.tostring(strategy.netprofit, "#.00"), text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.tiny)
